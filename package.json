{
  "name": "event-platform",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:portal": "pnpm --filter @event/portal dev",
    "dev:customer": "pnpm --filter @event/customer start",
    "dev:staff": "pnpm --filter @event/staff start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3"
  }
}
