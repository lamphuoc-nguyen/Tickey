# One shared Customer/Staff app. Copy to .env.local (not committed), use the project's public key.
# Android emulator: 10.0.2.2 · iOS simulator: localhost · real device: your machine's LAN IP.
EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=http://10.0.2.2:5080

# Leave empty until the real backend gateway adapter is configured; never simulate payment.
EXPO_PUBLIC_PAYMENT_GATEWAY=
