    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="page_title" value="PHYSICAL · 08 · Sổ cái và chi trả" style="text;html=1;align=left;fontFamily=Helvetica;fontSize=25;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="14" width="1800" height="45" as="geometry" />
